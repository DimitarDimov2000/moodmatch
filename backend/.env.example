MOODMATCH_DB_URL=jdbc:postgresql://localhost:5432/moodmatch
MOODMATCH_DB_USERNAME=your_local_database_user
MOODMATCH_DB_PASSWORD=your_local_database_password
QUARKUS_HTTP_CORS_ENABLED=true
QUARKUS_HTTP_CORS_ORIGINS=http://localhost:5173
# Optional real external provider for films and series.
# Leave blank to keep the offline DEMO fallback active.
MOODMATCH_TMDB_API_KEY=your_tmdb_v3_api_key_here
# Optional overrides if you need to point at non-default TMDB endpoints.
MOODMATCH_TMDB_BASE_URL=https://api.themoviedb.org/3
MOODMATCH_TMDB_IMAGE_BASE_URL=https://image.tmdb.org/t/p/w342
MOODMATCH_TMDB_WEBSITE_BASE_URL=https://www.themoviedb.org
# Open Library book search does not require a secret for the current public-search integration.
# LibriVox audiobook search does not require a secret for the current public catalog integration.
MOODMATCH_LIBRIVOX_BASE_URL=https://librivox.org

# Optional real external provider for games.
# Leave blank to keep the offline DEMO fallback active for automatic game searches.
MOODMATCH_RAWG_API_KEY=your_rawg_api_key_here

# Optional real external provider for podcast shows.
# Leave blank to keep automatic podcast search in warning-only mode without crashing.
MOODMATCH_PODCASTINDEX_KEY=your_podcast_index_key_here
MOODMATCH_PODCASTINDEX_SECRET=your_podcast_index_secret_here
MOODMATCH_PODCASTINDEX_BASE_URL=https://api.podcastindex.org/api/1.0

# Optional AniList override.
MOODMATCH_ANILIST_BASE_URL=

# Backend-only YouTube Data API key for VIDEO search and URL import.
# Do not commit real keys.
MOODMATCH_YOUTUBE_API_KEY=your_youtube_data_api_key_here
