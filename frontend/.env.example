# Frontend reference configuration. Copy to .env.local for local development.
# Use /api with the Vite proxy, or http://localhost:8080 for a direct backend URL.
VITE_API_BASE_URL=/api
# local-password is the normal prototype mode; local-demo is a development fallback.
VITE_AUTH_MODE=local-password
VITE_AUTH_PROVIDER=local-password
